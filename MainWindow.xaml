<Window x:Class="HashcatUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HashcatUI"
        mc:Ignorable="d"
        Title="Hashcat UI Panel ByMadman" Height="700" Width="950"
        Background="#F0F2F5">
    
    <!-- 简化的全局样式 -->
    <Window.Resources>
        <!-- 基础按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="35" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="500" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        
        <!-- 文本框样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        
        <!-- 标签样式 -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="500" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
        
        <!-- 组合框样式 -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        
        <!-- 复选框样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#333333" />
        </Style>
    </Window.Resources>
    
    <!-- 主内容区域 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0078D7" Offset="0" />
                    <GradientStop Color="#005a9e" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Label Content="Hashcat UI Panel" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   Padding="20" />
        </Grid>
        
        <!-- 主要内容网格 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 输入区域 -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                
                <!-- Hash值输入 -->
                <Label Grid.Row="0" Grid.Column="0" Content="Hash值:" />
                <TextBox Grid.Row="0" Grid.Column="1" Name="HashInput" TextWrapping="Wrap" AcceptsReturn="True" Height="70" />
                <Button Grid.Row="0" Grid.Column="2" Content="从文件加载" Click="LoadHashFromFile_Click" />

                <!-- 攻击模式 -->
                <Label Grid.Row="1" Grid.Column="0" Content="攻击模式:" />
                <ComboBox Grid.Row="1" Grid.Column="1" Name="AttackMode" SelectedIndex="0">
                    <ComboBoxItem>字典攻击 (-a 0)</ComboBoxItem>
                    <ComboBoxItem>掩码攻击 (-a 3)</ComboBoxItem>
                    <ComboBoxItem>组合攻击 (-a 1)</ComboBoxItem>
                    <ComboBoxItem>混合攻击 (-a 6)</ComboBoxItem>
                    <ComboBoxItem>混合攻击 (-a 7)</ComboBoxItem>
                </ComboBox>
                
                <!-- 哈希类型 -->
                <Label Grid.Row="2" Grid.Column="0" Content="哈希类型:" />
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Name="HashType" SelectedIndex="0">
                    <ComboBoxItem>MD5 (-m 0)</ComboBoxItem>
                    <ComboBoxItem>SHA1 (-m 100)</ComboBoxItem>
                    <ComboBoxItem>SHA256 (-m 1400)</ComboBoxItem>
                    <ComboBoxItem>NTLM (-m 1000)</ComboBoxItem>
                    <ComboBoxItem>MySQL (-m 300)</ComboBoxItem>
                </ComboBox>

                <!-- 字典文件/掩码设置 -->
                <Label Grid.Row="3" Grid.Column="0" Content="字典/掩码:" />
                <TextBox Grid.Row="3" Grid.Column="1" Name="DictionaryMaskInput" />
                <Button Grid.Row="3" Grid.Column="2" Content="浏览..." Click="BrowseFile_Click" />
                <Button Grid.Row="4" Grid.Column="2" Content="掩码预设" Click="ShowMaskPresetDialog" />
            </Grid>

            <!-- 其他选项和输出 -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- 选项行 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="其他选项:" />
                    <TextBox Grid.Column="1" Name="AdditionalOptions" Text="-w 3" />
                    <CheckBox Grid.Column="2" Content="使用GPU" Name="UseGPU" IsChecked="True" HorizontalAlignment="Left" />
                </Grid>
                
                <!-- 输出结果 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="输出结果:" Margin="0,0,0,5" />
                    <TextBox Grid.Row="1" Name="OutputResult" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Auto" 
                             IsReadOnly="True" 
                             Background="#F8F9FA" 
                             BorderBrush="#E0E0E0" 
                             FontFamily="Consolas" 
                             FontSize="13" />
                </Grid>
            </Grid>

            <!-- 按钮区域 -->
            <Grid Grid.Row="2" Margin="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="开始" Name="StartButton" Click="StartButton_Click" Margin="10" Background="#28A745" />
                    <Button Content="停止" Name="StopButton" Click="StopButton_Click" IsEnabled="False" Margin="10" Background="#DC3545" />
                    <Button Content="清除" Name="ClearButton" Click="ClearButton_Click" Margin="10" Background="#6C757D" />
                    <Button Content="导出结果" Name="ExportButton" Click="ExportButton_Click" Margin="10" Background="#FFC107" Foreground="#212529" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
